{
    "name": "SurfaceVessel",
    "package_name": "Ocean",
    "world": "PierHarbor",
    "main_agent": "auv0",
    "ticks_per_sec": 30,
    "frames_per_sec": 30,
    "agents": [
        {
        "agent_name": "auv0",
        "agent_type": "SurfaceVessel",
        "sensors": [
            {
                "sensor_type": "DynamicsSensor",
                "configuration": {
                    "UseCOM": true,
                    "UseRPY": false 
                },
                "ros_publish": true

            },
            {
                "sensor_type": "DVLSensor",
                "ros_publish": true,
                "configuration":{
                    "VelSigma": [0.1,0.1,0.1,0.1]
                }
            },
            {
                "sensor_type": "IMUSensor",
                "ros_publish": true,
                "socket": "COM",
                "configuration":{
                    "AccelSigma": [0.01,0.01,0.01],
                    "AngVelSigma": [0.01,0.01,0.01],
                    "ReturnBias": true
                }
            },
            {
                "sensor_type": "GPSSensor",
                "ros_publish": true,
                "tick_every": 30,
                "configuration":{
                    "Sigma": [0.001,0.001,0.001],
                    "Depth": 0.5,
                    "DepthSigma": 0.05
                }
            },
            {
                "sensor_type": "RotationSensor",
                "ros_publish": true
            },
            {
                "sensor_type": "RangeFinderSensor",
                "ros_publish": true,
                "configuration": {
                    "LaserMaxDistance": 50,
                    "LaserCount": 50
                }
            },
            {
                "sensor_type": "DepthSensor",
                "ros_publish": true,
                "configuration":{
                    "Sigma": 0.03
                }
            },
            {
                "sensor_type": "RGBCamera",
                "sensor_name": "FrontCamera",
                "ros_publish": true,
                "socket": "COM",
                "location": [1.0, 0, 0.5],
                "rotation": [0, 0, 0],
                "Hz": 10,
                "configuration": {
                    "CaptureWidth": 640,
                    "CaptureHeight": 480
                }
            },
            {
                "sensor_type": "SidescanSonar",
                "sensor_name": "SidescanSonar",
                "ros_publish": true,
                "waterfall_length": 500,
                "socket": "COM",
                "location": [0, 0, -0.5],
                "rotation": [0, 0, 0],
                "Hz": 10,
                "configuration": {
                    "RangeBins": 2000,
                    "Azimuth": 170,
                    "RangeMin": 0.5,
                    "RangeMax": 40,
                    "AddSigma": 0.05,
                    "MultSigma": 0.05,
                    "InitOctreeRange": 50
                }
            },
            {
                "sensor_type": "RaycastLidar",
                "sensor_name": "RaycastLidar",
                "ros_publish": true,
                "socket": "COM",
                "location": [0, 0, 1.5],
                "rotation": [0, 0, 0],
                "Hz": 10,
                "configuration": {
                    "Channels": 16,
                    "Range": 100.0,
                    "PointsPerSecond": 100000,
                    "RotationFrequency": 10.0,
                    "UpperFovLimit": 15.0,
                    "LowerFovLimit": -15.0,
                    "HorizontalFov": 360.0
                }
            }
        ],
        "control_scheme": 0,  
        "location": [0,-500,0],
        "rotation": [0,0,0]
        }
    ]
}